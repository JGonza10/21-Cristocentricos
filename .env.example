# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Llave secreta para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = la cookie de sesión solo viaja por conexión segura (funciona en http://localhost)
COOKIE_SECURE=1

# Horas que dura la sesión antes de pedir login otra vez
SESION_HORAS=8

# Máximo de cuentas (Gonza + Esbeidy)
MAX_USUARIOS=2

# Dónde escucha el servidor. 127.0.0.1 = solo esta PC (lo más seguro)
HOST=127.0.0.1
PORT=5021

# Base de datos. Vacío = SQLite en datos/cristocentricos.db.
# Con Railway: la DATABASE_PUBLIC_URL de su PostgreSQL (la laptop y la nube comparten la base).
# DATABASE_URL=

# local = la laptop (worker, videos, reels); nube = Railway (solo vigila el avance). Ver docs/railway.md
MODO=local

# 1 = se entra desde otra computadora por Tailscale (tailscale serve).
# Deja HOST=127.0.0.1: Tailscale es la única puerta de entrada desde fuera.
TAILSCALE=1

# Nombre que aparece en las imágenes y en los reels
CANAL_NOMBRE=Cristocéntricos
# Enlace del canal en vivo (opcional), por ejemplo youtube.com/@cristocentricos
CANAL_ENLACE=
# Modelo de Whisper: small (recomendado), base (más rápido) o medium (más preciso, más lento)
WHISPER_MODELO=small

# 1 = las 5 imágenes de difusión salen en cuanto se guarda el tema
DIFUSION_AL_GUARDAR=1
# Carpeta con la referencia y las herramientas del cliente (vacío = estilo_cliente/ del proyecto)
# ESTILO_DIR=
