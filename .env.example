# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Llave secreta para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = la cookie de sesión solo viaja por conexión segura (funciona en http://localhost)
COOKIE_SECURE=1

# Horas que dura la sesión antes de pedir login otra vez
SESION_HORAS=8

# Máximo de cuentas (Gonza + 1 aprobador)
MAX_USUARIOS=2

# Dónde escucha el servidor. 127.0.0.1 = solo esta PC (lo más seguro)
HOST=127.0.0.1
PORT=5021

# Base de datos (opcional). Vacío = SQLite en datos/cristocentricos.db
# DATABASE_URL=

# 1 = el aprobador entra desde otra computadora por Tailscale (tailscale serve).
# Deja HOST=127.0.0.1: Tailscale es la única puerta de entrada desde fuera.
TAILSCALE=1

# --- Contenido para redes (fases 3 y 4) ---
# Nombre que aparece en el carrusel y en los reels
CANAL_NOMBRE=Cristocéntricos
# Enlace del canal en vivo (opcional), por ejemplo youtube.com/@cristocentricos
CANAL_ENLACE=
# Modelo de Whisper: small (recomendado), base (más rápido) o medium (más preciso, más lento)
WHISPER_MODELO=small

# --- Equipo (fase 6) ---
# Cuántas personas apoyan en cada evento (además de quien dirige)
APOYOS_POR_EVENTO=1
# Calendario donde se crean los eventos ("primary" = el calendario principal de la cuenta)
GOOGLE_CALENDAR_ID=primary

# --- Reporte semanal (lunes 8 am) ---
# Meta de seguidores sumando todas las redes
META_SEGUIDORES=1000

# --- Publicación automática en Meta (fase 8, opcional) ---
# 0 = manual (se preparan carpetas en paquetes/<fecha>/subir_manual/). 1 = automático.
META_AUTO=0
META_PAGE_ID=
META_IG_USER_ID=
# Token de página de larga duración. Es un SECRETO: solo aquí, nunca en el código.
META_TOKEN=
META_GRAPH_VERSION=v23.0

# Solo para la copia de ejemplo (ejemplo.py la pone en 1 sola). Déjalo en 0 en la app real.
EJEMPLO=0

# Reels: mejora automática de luz, color y volumen (1 = sí, 0 = dejar el video como viene)
MEJORAR_VIDEO=1

# OBS (grabación del evento). La contraseña la escribe sola: flask --app app obs-configurar
OBS_PASSWORD=
OBS_PUERTO=4455
# 1 = los días de evento abre OBS y graba solo de 9:55 a 11:05
OBS_AUTO=1

# --- Versión corta (2026-10-19) ---
# 1 = proceso de 7 pasos (tema, guion, difusión, revisión, grabación, reels con estilo, ideas).
# 0 = proceso completo de la v1.0 (turnos, bandeja, publicación, reporte semanal y estadísticas).
#     Para la interfaz también cambia VERSION_CORTA en frontend/src/version.js y vuelve a compilar.
VERSION_CORTA=1
# OBS ya no se usa: la segunda toma la graba el celular. 1 = volver a grabar con OBS.
OBS_AUTO=0
# Difusión: 1 = además de las 5 imágenes, el reel promocional de 15 s
REEL_PROMO=0
# 1 = además de los reels, el carrusel con escenas del video
CARRUSEL_ESCENAS=0
# 1 = las 5 imágenes salen en cuanto se guarda el tema
DIFUSION_AL_GUARDAR=1
# Carpeta con la referencia y las herramientas del cliente (vacío = estilo_cliente/ del proyecto)
# ESTILO_DIR=
