# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Llave secreta para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = la cookie de sesión solo viaja por conexión segura (funciona en http://localhost)
COOKIE_SECURE=1

# Horas que dura la sesión antes de pedir login otra vez
SESION_HORAS=8

# Máximo de cuentas (Gonza + 1 aprobador)
MAX_USUARIOS=2

# Dónde escucha el servidor. 127.0.0.1 = solo esta PC (lo más seguro)
HOST=127.0.0.1
PORT=5000

# Base de datos (opcional). Vacío = SQLite en datos/cristocentricos.db
# DATABASE_URL=

# 1 = el aprobador entra desde otra computadora por Tailscale (tailscale serve).
# Deja HOST=127.0.0.1: Tailscale es la única puerta de entrada desde fuera.
TAILSCALE=1

# --- Contenido para redes (fases 3 y 4) ---
# Nombre que aparece en el carrusel y en los reels
CANAL_NOMBRE=Cristocéntricos
# Enlace del canal en vivo (opcional), por ejemplo youtube.com/@cristocentricos
CANAL_ENLACE=
# Modelo de Whisper: small (recomendado), base (más rápido) o medium (más preciso, más lento)
WHISPER_MODELO=small

# --- Equipo (fase 6) ---
# Cuántas personas apoyan en cada rosario (además de quien dirige)
APOYOS_POR_ROSARIO=1
# Calendario donde se crean los eventos ("primary" = el calendario principal de la cuenta)
GOOGLE_CALENDAR_ID=primary

# --- Publicación automática en Meta (fase 8, opcional) ---
# 0 = manual (se preparan carpetas en paquetes/<fecha>/subir_manual/). 1 = automático.
META_AUTO=0
META_PAGE_ID=
META_IG_USER_ID=
# Token de página de larga duración. Es un SECRETO: solo aquí, nunca en el código.
META_TOKEN=
META_GRAPH_VERSION=v23.0
